## Environment configuration
SERVER_PORT=8080
DB_PATH=./indexarr.db
MEDIAINFO_PATH=mediainfo
TZ=Europe/Paris
LOG_LEVEL=INFO


## Scanning configuration
# MEDIA_LIBRARY_PATHS=/mnt/video/movies,/mnt/video/series
MOVIES_LIBRARY_PATHS=/mnt/video/movies
SERIES_LIBRARY_PATHS=/mnt/video/series

SCAN_INTERVAL=24
SCAN_TIMEOUT=30
SKIP_FOLDERS=Behind The Scenes,Deleted Scenes,Featurettes,Interviews,Scenes,Shorts,Trailers,Other
IGNORE_FILE_PATTERN=

DETECTION_LANGUAGE=en
METADATA_LANGUAGE=en

TMDB_API_KEY=your_tmdb_api_key_here
TVDB_API_KEY=your_tvdb_api_key_here


## Radarr and Sonarr integration (optional)
RADARR_URL=http://radarr:7878
SONARR_URL=http://sonarr:8989
RADARR_API_KEY=your_radarr_api_key_here
SONARR_API_KEY=your_sonarr_api_key_here

# Path mapping for Docker environments (format: "from:to")
RADARR_PATH_MAPPING=
SONARR_PATH_MAPPING=


## Authentication configuration
# AUTH_MODE: none (default), simple, oidc
AUTH_MODE=none
# Simple auth (required when AUTH_MODE=simple)
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=your_secure_password_here
# Session secret (auto-generated if not provided)
AUTH_SESSION_SECRET=
# Session duration in hours (default: 168 = 7 days)
AUTH_SESSION_MAX_AGE=168
